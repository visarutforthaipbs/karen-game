; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Satellite Shadow"
config/description="Isometric Tactical Survival & Systemic Stealth Sim"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputBindings="*res://scripts/InputBindings.gd"
GameState="*res://scripts/GameState.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom_font="res://assets/fonts/Kanit-Regular.ttf"

[internationalization]

locale/include_text_server_data=true

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
