; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Under Two Skies"
config/version="0.3.0"
config/description="Isometric Tactical Survival & Systemic Stealth Sim"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/logo/under_two_skies_icon.png"

[autoload]

Localization="*res://scripts/Localization.gd"
InputBindings="*res://scripts/InputBindings.gd"
GameState="*res://scripts/GameState.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false

; Touch is handled explicitly (scripts/TouchControls.gd): mouse emulation only tracks
; finger #0, which breaks two-thumb play (move left, tap right).
[input_devices]

pointing/emulate_mouse_from_touch=false

; UITheme supplies runtime fonts; an eager global font breaks clean imports.
[internationalization]

locale/include_text_server_data=true

[rendering]

; Desktop stays Forward+; iOS/Android use the Mobile renderer (Metal/Vulkan).
renderer/rendering_method.mobile="mobile"
; Mobile quality profile (iPhone 14 Pro measured GPU-bound at ~25 ms/frame after the
; geometry and draw-call fixes): render 3D at 85% and cheaper directional shadows.
; Desktop keeps the defaults.
scaling_3d/scale.mobile=0.85
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
