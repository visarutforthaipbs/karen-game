				[_p([13, 4, 13, 9, 15, 21, 21, 20, 21, 13, 17, 8]), 2],
				[_p([11, 2, 13, 2, 13, 10, 11, 10]), 1],
			]
		"rice":
			return [
				[_p([11, 23, 13, 23, 13, 8, 11, 8]), 2],
				[_p([12, 1, 15, 5, 12, 8, 9, 5]), 3],
				[_p([5, 6, 10, 9, 8, 12, 4, 10]), 3],
				[_p([19, 6, 20, 10, 16, 12, 14, 9]), 0],
				[_p([4, 13, 10, 14, 9, 17, 4, 16]), 0],
				[_p([20, 13, 20, 16, 15, 17, 14, 14]), 3],
			]
		"crew":
			return [
