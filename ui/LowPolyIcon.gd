				[_p([4, 13, 12, 13, 12, 19, 4, 19]), 5],
				[_p([17, 13, 20, 16, 17, 19, 14, 16]), 3],
				[_p([15, 8, 21, 1, 22, 2, 17, 8]), 2],
			]
		"mountain":
			return [
				[_p([1, 21, 9, 6, 13, 13, 17, 21]), 0],
				[_p([9, 6, 12, 21, 1, 21]), 1],
				[_p([10, 21, 16, 9, 23, 21]), 2],
