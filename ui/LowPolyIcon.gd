		"hotspot":
			return [
				[_p([12, 1, 23, 12, 12, 23, 1, 12]), 2],
				[_p([12, 5, 19, 12, 12, 19, 5, 12]), 0],
				[_p([12, 9, 15, 12, 12, 15, 9, 12]), 3],
			]
		"clock":
			return [
				[_p([12, 1, 20, 4, 23, 12, 20, 20, 12, 23, 4, 20, 1, 12, 4, 4]), 2],
				[_p([12, 4, 18, 6, 20, 12, 18, 18, 12, 20, 6, 18, 4, 12, 6, 6]), 5],
				[_p([11, 6, 13, 6, 13, 13, 11, 13]), 3],
				[_p([11, 11, 17, 14, 16, 16, 11, 13]), 0],
			]
		"whistle":
			return [
				[_p([3, 9, 16, 9, 16, 17, 3, 17]), 0],
				[_p([3, 9, 16, 9, 15, 11, 4, 11]), 1],
				[_p([16, 10, 22, 8, 22, 12, 16, 13]), 2],
				[_p([7, 12, 10, 12, 10, 15, 7, 15]), 5],
			]
	return [[_p([12, 2, 22, 12, 12, 22, 2, 12]), 0]]
