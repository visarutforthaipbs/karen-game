class_name LowPolyIcon
extends Control

## Flat-shaded polygon icons on a 24x24 grid. Each shape is split into a lit
## and a shaded facet so they read like the low-poly props on the hillside.

@export var kind: String = "flame":
	set(v):
		kind = v
		queue_redraw()
@export var color: Color = UITheme.STRAW:
	set(v):
		color = v
		queue_redraw()

func _init() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func _draw() -> void:
	var s = minf(size.x, size.y) / 24.0
	var origin = (size - Vector2(24, 24) * s) * 0.5
	for part in _shapes(kind):
		var pts = PackedVector2Array()
		for p in part[0]:
			pts.append(origin + p * s)
		draw_colored_polygon(pts, _tone(part[1]))

func _tone(t: int) -> Color:
	match t:
		1: return color.lightened(0.28)
		2: return color.darkened(0.3)
		3: return UITheme.STRAW
		4: return UITheme.EMBER
		5: return Color(UITheme.INK, 0.85)
	return color

static func _p(arr: Array) -> PackedVector2Array:
	var out = PackedVector2Array()
	for i in range(0, arr.size(), 2):
		out.append(Vector2(arr[i], arr[i + 1]))
	return out

## Returns [[points, tone], ...]; tone 0 base, 1 lit, 2 shade, 3 straw, 4 ember, 5 ink
static func _shapes(k: String) -> Array:
	match k:
		"flame":
			return [
				[_p([12, 1, 19, 11, 18, 19, 12, 23]), 2],
				[_p([12, 1, 12, 23, 6, 19, 5, 11]), 0],
				[_p([12, 9, 15, 15, 14, 20, 12, 22, 10, 20, 9, 15]), 3],
			]
		"blade":
			return [
				[_p([3, 19, 17, 4, 21, 3, 20, 7, 6, 21]), 1],
				[_p([3, 19, 6, 21, 20, 7, 18, 7]), 2],
				[_p([2, 18, 6, 22, 3, 24, 0, 21]), 5],
				[_p([14, 14, 22, 21, 20, 23, 12, 16]), 3],
			]
		"drop":
			return [
				[_p([12, 1, 18, 12, 19, 17, 12, 23]), 2],
				[_p([12, 1, 12, 23, 5, 17, 6, 12]), 0],
				[_p([9, 13, 11, 12, 10, 18, 8, 16]), 1],
			]
		"wind":
			return [
				[_p([2, 6, 15, 6, 18, 3, 21, 6, 17, 9, 2, 9]), 0],
				[_p([2, 11, 20, 11, 23, 14, 20, 17, 17, 14, 2, 14]), 1],
				[_p([2, 16, 11, 16, 13, 19, 10, 22, 8, 19, 2, 19]), 2],
			]
		"eye":
			return [
				[_p([1, 12, 8, 6, 16, 6, 23, 12]), 1],
				[_p([1, 12, 23, 12, 16, 18, 8, 18]), 0],
				[_p([12, 7, 16, 9, 17, 13, 14, 17, 10, 17, 7, 13, 8, 9]), 5],
				[_p([12, 9, 14, 12, 12, 15, 10, 12]), 0],
