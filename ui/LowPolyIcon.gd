		"satellite":
			return [
				[_p([9, 9, 15, 9, 15, 15, 9, 15]), 1],
				[_p([1, 5, 7, 9, 7, 15, 1, 11]), 0],
				[_p([23, 5, 17, 9, 17, 15, 23, 11]), 2],
				[_p([11, 15, 13, 15, 14, 21, 10, 21]), 0],
				[_p([12, 21, 16, 23, 8, 23]), 3],
			]
		"drone":
			return [
				[_p([3, 11, 21, 11, 21, 13, 3, 13]), 2],
				[_p([9, 9, 15, 9, 16, 15, 8, 15]), 0],
				[_p([0, 7, 7, 7, 6, 9, 1, 9]), 1],
				[_p([17, 7, 24, 7, 23, 9, 18, 9]), 1],
